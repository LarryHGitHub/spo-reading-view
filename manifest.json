{
  "manifest_version": 3,
  "name": "SPO Reading View",
  "short_name": "SPO Reader",
  "version": "2.3.0",
  "description": "Opens Word and Excel files from SharePoint Online and OneDrive for work or school in Reading View instead of Editing View.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "SPO Reading View",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.sharepoint.com/:*", "https://*.sharepoint.cn/:*"],
      "js": ["share_resolver.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "webRequest"],
  "host_permissions": ["https://*.sharepoint.com/*", "https://*.sharepoint.cn/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "force_view_default", "enabled": true,  "path": "rules_default.json" },
      { "id": "force_view_edit",    "enabled": false, "path": "rules_edit.json" }
    ]
  }
}
